<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:paddingBottom="20dp"
    android:background="@drawable/bottom_sheet_fragment_bg">

    <ImageView
        android:id="@+id/rectangle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_rectangle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!--    Title Text View-->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:gravity="start"
        android:text="@string/title"
        android:textColor="@color/names_title_color"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rectangle" />

    <!--    Title Input Field-->

        <!--    Title Input Edit text (will take Title value from it by id)-->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/taskTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/rounded_input_border"
        android:ellipsize="end"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:hint="@string/enter_title"
        android:textColorHint="@color/names_hint_color"
        android:textColor="@color/entered_text_color"
        android:textCursorDrawable="@null"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView" />

    <TextView
        android:id="@+id/descriptionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:gravity="start"
        android:text="@string/description"
        android:textColor="@color/names_title_color"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/taskTitleInput" />

    <!--   Description Input Field-->

        <!--    Description Input Edit text (will take Title value from it by id)-->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/taskDescriptionInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:paddingLeft="10dp"
            android:paddingTop="16dp"
            android:background="@drawable/rounded_input_border"
            android:gravity="top"
            android:maxLines="6"
            android:minLines="2"
            android:hint="@string/enter_description"
            android:textColorHint="@color/names_hint_color"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="always"
            android:textCursorDrawable="@null"
            android:textColor="@color/entered_text_color"
            app:layout_constraintEnd_toEndOf="@+id/taskTitleInput"
            app:layout_constraintStart_toStartOf="@+id/descriptionTextView"
            app:layout_constraintTop_toBottomOf="@+id/descriptionTextView"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/microphoneButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/create_to_do_list_button_background"
        android:text="@string/voice_input"
        android:textAllCaps="false"
        android:textColor="@color/names_title_color"
        android:textSize="16dp"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_microphone_2"
        app:iconTint="@color/names_title_color"
        app:layout_constraintStart_toStartOf="@+id/taskDescriptionInput"
        app:layout_constraintTop_toBottomOf="@+id/taskDescriptionInput"
        app:rippleColor="#5555A4"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/locationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/create_to_do_list_button_background"
        android:maxWidth="185dp"
        android:text="@string/add_location_title"
        android:textAllCaps="false"
        android:textColor="@color/names_title_color"
        android:textSize="16dp"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_location_new_small"
        app:iconTint="@color/names_title_color"
        app:layout_constraintStart_toEndOf="@+id/microphoneButton"
        app:layout_constraintTop_toBottomOf="@+id/taskDescriptionInput"
        app:rippleColor="#5555A4"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pickDateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/create_to_do_list_button_background"
        android:text="@string/add_date_title"
        android:textAllCaps="false"
        android:textColor="@color/names_title_color"
        android:textSize="16dp"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_calendar_edit"
        app:iconTint="@color/names_title_color"
        app:layout_constraintBottom_toTopOf="@+id/taskPriorityGroupLayout"
        app:layout_constraintStart_toStartOf="@+id/microphoneButton"
        app:layout_constraintTop_toBottomOf="@+id/microphoneButton"
        app:layout_constraintVertical_bias="0.0"
        app:rippleColor="#5555A4"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:id="@+id/taskPriorityGroupLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="@+id/taskDescriptionInput"
        app:layout_constraintStart_toStartOf="@+id/pickDateButton"
        app:layout_constraintTop_toBottomOf="@+id/pickDateButton"
        tools:ignore="MissingConstraints,NotSibling">

        <RadioGroup
            android:id="@+id/taskPriorityGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            tools:ignore="MissingConstraints,NotSibling">

            <RadioButton
                android:id="@+id/highPriority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:buttonTint="#C40D34"
                android:layout_marginStart="20dp"
                android:drawableStart="@drawable/high_priority_radio"
                android:drawablePadding="4dp"
                android:text="@string/high_priority_title"
                android:textColor="@drawable/priority_high_selector"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/mediumPriority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:button="@null"
                android:buttonTint="#EE9B2B"
                android:drawableStart="@drawable/medium_priority_radio"
                android:drawablePadding="4dp"
                android:text="@string/medium_priority_title"
                android:textColor="@drawable/priority_medium_selector"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/lowPriority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:button="@null"
                android:buttonTint="#149F50"
                android:drawableStart="@drawable/low_priority_radio"
                android:drawablePadding="4dp"
                android:text="@string/low_priority_title"
                android:textColor="@drawable/priority_low_selector"
                android:checked="true"
                android:textSize="12sp"
                android:textStyle="bold" />

        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/pickDateButton"
        app:layout_constraintTop_toBottomOf="@+id/taskPriorityGroupLayout">

        <Button
            android:id="@+id/saveTaskButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/continue_button_background"
            android:text="@string/btn_continue"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            app:backgroundTint="@null"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>