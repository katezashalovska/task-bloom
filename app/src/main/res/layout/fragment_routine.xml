<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoutineLayout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background_color">

    <LinearLayout
        android:id="@+id/routineLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="6dp"
        android:background="@color/page_background_color"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@color/page_background_color"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/icMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="menu"
                android:src="@drawable/ic_account"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/icSettings"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/icMenu"
                tools:ignore="MissingConstraints">

                <LinearLayout
                    android:id="@+id/linearLayout3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0">

                    <TextView
                        android:id="@+id/dayOfWeek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Friday"
                        android:textColor="@color/day_of_week_color"
                        android:textSize="14sp"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/dateTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="October17"
                        android:textColor="@color/month_color"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:ignore="MissingConstraints" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageButton
                android:id="@+id/icSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="menu"
                android:src="@drawable/ic_settings_new"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="248dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_round_yellow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alexandria"
                    android:text="@string/hello_text"
                    android:textColor="@color/hello_color"
                    android:textSize="36dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="34dp"
                    android:src="@drawable/ic_round_pink_small" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="27dp"
                    android:src="@drawable/ic_round_blue" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/have_a_nice_day"
                android:textColor="@color/have_a_nice_day_color"
                android:textSize="16dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/plugLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="2dp"
        android:layout_below="@id/routineLayout"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/roundPink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_round_pink" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toDoListFilterMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/rounded_background_for_filter_menu">

            <TextView
                android:id="@+id/allTaskPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/routine_button_selector"
                android:paddingLeft="8dp"
                android:paddingTop="10dp"
                android:paddingRight="8dp"
                android:paddingBottom="10dp"
                android:text="All task"
                android:textColor="@drawable/routine_text_color_selector"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/dailyPlug"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/dailyPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/routine_button_selector"
                android:paddingLeft="8dp"
                android:paddingTop="10dp"
                android:paddingRight="8dp"
                android:paddingBottom="10dp"
                android:text="Daily"
                android:textColor="@drawable/routine_text_color_selector"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/weeklyPlug"
                app:layout_constraintStart_toEndOf="@id/allTaskPlug"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/weeklyPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/routine_button_selector"
                android:paddingLeft="8dp"
                android:paddingTop="10dp"
                android:paddingRight="8dp"
                android:paddingBottom="10dp"
                android:text="Weekly"
                android:textColor="@drawable/routine_text_color_selector"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/monthlyPlug"
                app:layout_constraintStart_toEndOf="@id/dailyPlug"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/monthlyPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/routine_button_selector"
                android:paddingLeft="8dp"
                android:paddingTop="10dp"
                android:paddingRight="8dp"
                android:paddingBottom="10dp"
                android:text="Monthly"
                android:textColor="@drawable/routine_text_color_selector"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/annualPlug"
                app:layout_constraintStart_toEndOf="@id/weeklyPlug"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/annualPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/routine_button_selector"
                android:paddingLeft="8dp"
                android:paddingTop="10dp"
                android:paddingRight="8dp"
                android:paddingBottom="10dp"
                android:text="Annual"
                android:textColor="@drawable/routine_text_color_selector"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/monthlyPlug"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/greetingLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/plugLayout"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/empty_to_do_plug_background"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            app:srcCompat="@drawable/ic_empty_to_do_list" />

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/alexandria"
            android:text="@string/no_routine_tasks_yet"
            android:textAlignment="center"
            android:textColor="@color/no_task_yet_text_color"
            android:textSize="22sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/routineRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/greetingLinearLayout"
        android:layout_alignParentBottom="true"
        android:scrollbars="vertical"
        tools:ignore="MissingConstraints" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/routineViewPager"
        android:layout_above="@id/routineMessageLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingBottom="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/routineMessageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="36dp"
        android:clickable="false"
        android:focusable="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/routineSuccessfullyAdded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="@string/routine_task_successfully_added"
            android:contentDescription="adding message"
            android:background="@drawable/task_successfully_added_background"
            android:textColor="@color/added_success_text_color"
            app:icon="@drawable/to_do_list_star"
            app:iconTint="@color/added_success_icon_color"
            android:fontFamily="@font/alexandria"
            android:textSize="15dp"
            app:backgroundTint="@null"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:clickable="false"
            android:focusable="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/routineSuccessfullyDeleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="@string/routine_task_successfully_deleted"
            android:contentDescription="deleting message"
            android:background="@drawable/task_successfully_added_background"
            android:textColor="@color/added_success_text_color"
            android:textSize="15dp"
            android:fontFamily="@font/alexandria"
            app:icon="@drawable/to_do_list_trash"
            app:iconTint="@color/added_success_icon_color"
            app:backgroundTint="@null"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:clickable="false"
            android:focusable="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>