<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainToDoListLayout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background_color"
    tools:context=".ui.HomeFragment">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="6dp"
        android:background="@color/page_background_color"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@color/page_background_color"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="menu"
                android:src="@drawable/ic_account"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/icSettings"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/account"
                tools:ignore="MissingConstraints">

                <ImageButton
                    android:id="@+id/previousDateButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous_date"
                    android:src="@drawable/new_arrow_left"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/linearLayout3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

                <LinearLayout
                    android:id="@+id/linearLayout3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/nextDateButton"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@+id/previousDateButton"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0">

                    <TextView
                        android:id="@+id/dayOfWeek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Friday"
                        android:textColor="@color/day_of_week_color"
                        android:textSize="14sp"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/dateTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="October17"
                        android:textColor="@color/month_color"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:ignore="MissingConstraints" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/nextDateButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_date"
                    android:rotation="180"
                    android:src="@drawable/new_arrow_left"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="MissingConstraints" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageButton
                android:id="@+id/icSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="menu"
                android:src="@drawable/ic_settings_new"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="248dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_round_yellow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alexandria"
                    android:text="@string/hello_text"
                    android:textColor="@color/hello_color"
                    android:textSize="36dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="34dp"
                    android:src="@drawable/ic_round_pink_small" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="27dp"
                    android:src="@drawable/ic_round_blue" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/have_a_nice_day"
                android:textColor="@color/have_a_nice_day_color"
                android:textSize="16dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/plugLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="2dp"
        android:layout_below="@id/headerLayout"
        android:visibility="gone"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/roundPink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_round_pink" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toDoListFilterMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/allTaskPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/plug_background"
                android:paddingLeft="18dp"
                android:paddingTop="10dp"
                android:paddingRight="18dp"
                android:paddingBottom="10dp"
                android:text="All task"
                android:textColor="@color/filter_item_color"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/homePlug"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/homePlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/plug_background"
                android:paddingLeft="18dp"
                android:paddingTop="10dp"
                android:paddingRight="18dp"
                android:paddingBottom="10dp"
                android:text="Home"
                android:textColor="@color/filter_item_color"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/educationPlug"
                app:layout_constraintStart_toEndOf="@id/allTaskPlug"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/educationPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/plug_background"
                android:paddingLeft="18dp"
                android:paddingTop="10dp"
                android:paddingRight="18dp"
                android:paddingBottom="10dp"
                android:text="Education"
                android:textColor="@color/filter_item_color"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/buyPlug"
                app:layout_constraintStart_toEndOf="@id/homePlug"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/buyPlug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/plug_background"
                android:paddingLeft="18dp"
                android:paddingTop="10dp"
                android:paddingRight="18dp"
                android:paddingBottom="10dp"
                android:text="Buy"
                android:textColor="@color/filter_item_color"
                android:fontFamily="@font/alexandria"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/educationPlug"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Устанавливаем цепочку -->
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/toDoListPlugLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_below="@id/plugLayout"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:background="@drawable/empty_to_do_plug_background"
        android:visibility="gone"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:src="@drawable/ic_empty_to_do_list"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_tasks_yet"
            android:textSize="22dp"
            android:fontFamily="@font/alexandria"
            android:textColor="@color/no_task_yet_text_color"
            android:textAlignment="center"/>


    </LinearLayout>


    <!-- RecyclerView adjusted to fit the screen -->
    <!-- <androidx.recyclerview.widget.RecyclerView
         android:id="@+id/todoRecyclerView"
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_marginTop="4dp"
         android:layout_below="@id/plugLayout"
         android:scrollbars="vertical" /> -->

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/plugLayout"
        android:background="@color/page_background_color" />

     <androidx.constraintlayout.widget.ConstraintLayout
         android:id="@+id/messageLayout"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_alignParentBottom="true"
         android:layout_marginBottom="36dp"
         android:clickable="false"
         android:focusable="false">

         <com.google.android.material.button.MaterialButton
             android:id="@+id/taskSuccessfullyAdded"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:alpha="0"
             android:text="@string/task_successfully_added"
             android:contentDescription="adding message"
             android:background="@drawable/task_successfully_added_background"
             android:textColor="@color/added_success_text_color"
             app:icon="@drawable/to_do_list_star"
             app:iconTint="@color/added_success_icon_color"
             android:fontFamily="@font/alexandria"
             android:textSize="15dp"
             app:backgroundTint="@null"
             android:textAllCaps="false"
             app:layout_constraintBottom_toBottomOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintTop_toTopOf="parent"
             android:clickable="false"
             android:focusable="false"/>

         <com.google.android.material.button.MaterialButton
             android:id="@+id/taskSuccessfullyDeleted"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:alpha="0"
             android:text="@string/task_successfully_deleted"
             android:contentDescription="deleting message"
             android:background="@drawable/task_successfully_added_background"
             android:textColor="@color/added_success_text_color"
             android:textSize="15dp"
             android:fontFamily="@font/alexandria"
             app:icon="@drawable/to_do_list_trash"
             app:iconTint="@color/added_success_icon_color"
             app:backgroundTint="@null"
             android:textAllCaps="false"
             app:layout_constraintBottom_toBottomOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintTop_toTopOf="parent"
             android:clickable="false"
             android:focusable="false"/>

     </androidx.constraintlayout.widget.ConstraintLayout>

 </RelativeLayout>