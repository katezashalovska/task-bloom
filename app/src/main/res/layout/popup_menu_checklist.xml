<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toDoListPopupWindow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_menu">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/task_popup_window_background_color"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/editChecklist"
                android:background="@drawable/popup_selector_to_do_list"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginVertical="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_pencil_edit"
                    />
                <TextView
                    android:id="@+id/editButtonTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="16dp"
                    android:text="@string/btn_edit_checklist"
                    android:textColor="@color/ic_pencil_edit_color"
                    android:textSize="16sp"
                    />

            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_checklist_popup_separator"/>

            <LinearLayout
                android:id="@+id/deleteChecklist"
                android:background="@drawable/popup_selector_to_do_list"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginVertical="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_trash"
                    />

                <TextView
                    android:id="@+id/deleteButtonTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="16dp"
                    android:layout_marginEnd="15dp"
                    android:text="@string/btn_delete_checklist"
                    android:textColor="#FF3232"
                    android:textSize="16sp"
                    />


            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
